{
  "name": "ctf-discord-bot",
  "version": "0.1.0",
  "description": "A bot to manage roles and such on Discord",
  "homepage": "https://github.com/MT-CTF/ctf-discord-bot#readme",
  "bugs": {
    "url": "https://github.com/MT-CTF/ctf-discord-bot/issues"
  },
  "license": "MIT",
  "author": "rubenwardy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MT-CTF/ctf-discord-bot.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "tsc && node dist/index.js",
    "start:prod": "node dist/index.js",
    "build": "tsc",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "redis": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "error"
    }
  }
}
